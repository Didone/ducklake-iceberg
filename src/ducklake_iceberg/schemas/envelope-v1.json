{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ducklake_iceberg.dev/schemas/envelope-v1.json",
  "title": "ducklake-iceberg envelope v1",
  "description": "--json envelope of `ducklake-iceberg sync`. Keys not listed are allowed in items: the consumer ignores what it does not know.",
  "type": "object",
  "required": [
    "version",
    "command",
    "status",
    "exit_code",
    "dry_run",
    "started_at",
    "duration_ms",
    "config",
    "results",
    "problems"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "command": {
      "const": "sync"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "blocked",
        "diverged",
        "nothing-to-do"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "dry_run": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "config": {
      "type": [
        "object",
        "null"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sync_result"
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problem"
      }
    },
    "timings": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "problem": {
      "type": "object",
      "required": [
        "code",
        "message",
        "hint",
        "table"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "additionalProperties": false
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase_metric": {
      "type": "object",
      "required": [
        "phase",
        "started_at",
        "duration_ms",
        "items",
        "bytes",
        "calls",
        "retries",
        "ok",
        "error_code"
      ],
      "properties": {
        "phase": {
          "enum": [
            "resolve",
            "doctor",
            "checkpoint",
            "delta",
            "enumerate",
            "footers",
            "stats",
            "deletes",
            "manifest",
            "manifest_list",
            "metadata_json",
            "s3_put",
            "glue"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "$ref": "#/$defs/count"
        },
        "items": {
          "$ref": "#/$defs/count"
        },
        "bytes": {
          "$ref": "#/$defs/count"
        },
        "calls": {
          "$ref": "#/$defs/count"
        },
        "retries": {
          "$ref": "#/$defs/count"
        },
        "ok": {
          "type": "boolean"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "run_id",
        "duration_ms",
        "phases",
        "totals"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "duration_ms": {
          "$ref": "#/$defs/count"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase_metric"
          }
        },
        "totals": {
          "type": "object",
          "required": [
            "api_calls",
            "retries"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "sync_table": {
      "type": "object",
      "required": [
        "table",
        "steps",
        "exit_code",
        "ducklake_snapshot_id",
        "iceberg_snapshot_id",
        "metadata_location",
        "files_added",
        "files_removed",
        "bytes_referenced"
      ],
      "properties": {
        "table": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "exit_code"
            ],
            "properties": {
              "step": {
                "enum": [
                  "doctor",
                  "checkpoint",
                  "export",
                  "register"
                ]
              },
              "exit_code": {
                "$ref": "#/$defs/count"
              }
            }
          }
        },
        "exit_code": {
          "$ref": "#/$defs/count"
        },
        "duration_ms": {
          "$ref": "#/$defs/count"
        },
        "ducklake_snapshot_id": {
          "$ref": "#/$defs/snapshot_id"
        },
        "iceberg_snapshot_id": {
          "$ref": "#/$defs/snapshot_id"
        },
        "metadata_location": {
          "$ref": "#/$defs/location"
        },
        "files_added": {
          "$ref": "#/$defs/count"
        },
        "files_removed": {
          "$ref": "#/$defs/count"
        },
        "delete_files_added": {
          "$ref": "#/$defs/count"
        },
        "bytes_referenced": {
          "$ref": "#/$defs/count"
        },
        "bytes_written": {
          "$ref": "#/$defs/count"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      },
      "description": "One result per synced table; `steps` lists the stages that ran (doctor, checkpoint, export, register)."
    },
    "sync_aborted": {
      "description": "Partial result of a sync that ended on an unhandled exception (problem internal_error): only the steps that ran, no totals.",
      "type": "object",
      "required": [
        "table",
        "steps"
      ],
      "properties": {
        "table": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "exit_code"
            ],
            "properties": {
              "step": {
                "enum": [
                  "doctor",
                  "checkpoint",
                  "export",
                  "register"
                ]
              },
              "exit_code": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "sync_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/sync_table"
        },
        {
          "$ref": "#/$defs/sync_aborted"
        }
      ]
    }
  }
}
